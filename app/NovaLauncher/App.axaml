<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaLauncher.App"
             RequestedThemeVariant="Dark">

  <!-- 可动态替换的强调色（代码里按设置覆盖），其余颜色按主题字典在深/浅两套间切换 -->
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AccentBrush" Color="#3FA54B" />

      <ResourceDictionary.ThemeDictionaries>
        <!-- 深色主题 -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBg" Color="#0F1115" />
          <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED" />
          <SolidColorBrush x:Key="TextMuted" Color="#9AA0A6" />
          <SolidColorBrush x:Key="NavText" Color="#B9BEC4" />
          <SolidColorBrush x:Key="NavHoverBg" Color="#1D222B" />
          <SolidColorBrush x:Key="NavSelectedBg" Color="#16351F" />
          <SolidColorBrush x:Key="NavSelectedFg" Color="#7FE08C" />
          <SolidColorBrush x:Key="NavSelectedHoverBg" Color="#1C4427" />
          <SolidColorBrush x:Key="CardBg" Color="#161A21" />
          <SolidColorBrush x:Key="CardBorder" Color="#222834" />
          <SolidColorBrush x:Key="RowItemBg" Color="#161A21" />
          <SolidColorBrush x:Key="RowItemHoverBg" Color="#1B212B" />
          <SolidColorBrush x:Key="PrimaryBg" Color="#3FA54B" />
          <SolidColorBrush x:Key="PrimaryHoverBg" Color="#4CBE59" />
          <SolidColorBrush x:Key="PrimaryDisabledBg" Color="#2A4A30" />
          <SolidColorBrush x:Key="SecondaryBg" Color="#232936" />
          <SolidColorBrush x:Key="SecondaryFg" Color="#D5DAE0" />
          <SolidColorBrush x:Key="SecondaryHoverBg" Color="#2C3442" />
          <SolidColorBrush x:Key="SecondaryBorder" Color="#2E3646" />
          <SolidColorBrush x:Key="DangerBg" Color="#3A2020" />
          <SolidColorBrush x:Key="DangerFg" Color="#F0A0A0" />
          <SolidColorBrush x:Key="DangerBorder" Color="#4A2A2A" />
          <SolidColorBrush x:Key="BadgeDefault" Color="#23352A" />
          <SolidColorBrush x:Key="BadgeRelease" Color="#23352A" />
          <SolidColorBrush x:Key="BadgeSnapshot" Color="#352D23" />
          <SolidColorBrush x:Key="BadgeOther" Color="#272733" />
          <SolidColorBrush x:Key="ArgItemBg" Color="#1D222B" />
        </ResourceDictionary>

        <!-- 浅色主题 -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBg" Color="#F5F6F8" />
          <SolidColorBrush x:Key="TextPrimary" Color="#1A1D21" />
          <SolidColorBrush x:Key="TextMuted" Color="#5F6368" />
          <SolidColorBrush x:Key="NavText" Color="#3C4043" />
          <SolidColorBrush x:Key="NavHoverBg" Color="#E8EAED" />
          <SolidColorBrush x:Key="NavSelectedBg" Color="#E3F2E6" />
          <SolidColorBrush x:Key="NavSelectedFg" Color="#1E7B34" />
          <SolidColorBrush x:Key="NavSelectedHoverBg" Color="#D6ECDA" />
          <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#E0E3E8" />
          <SolidColorBrush x:Key="RowItemBg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RowItemHoverBg" Color="#F1F3F5" />
          <SolidColorBrush x:Key="PrimaryBg" Color="#2E9B3F" />
          <SolidColorBrush x:Key="PrimaryHoverBg" Color="#36AD47" />
          <SolidColorBrush x:Key="PrimaryDisabledBg" Color="#B9DFC0" />
          <SolidColorBrush x:Key="SecondaryBg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SecondaryFg" Color="#202124" />
          <SolidColorBrush x:Key="SecondaryHoverBg" Color="#F1F3F5" />
          <SolidColorBrush x:Key="SecondaryBorder" Color="#D0D4DA" />
          <SolidColorBrush x:Key="DangerBg" Color="#FBEBEB" />
          <SolidColorBrush x:Key="DangerFg" Color="#C62828" />
          <SolidColorBrush x:Key="DangerBorder" Color="#F2C6C6" />
          <SolidColorBrush x:Key="BadgeDefault" Color="#E7F0EA" />
          <SolidColorBrush x:Key="BadgeRelease" Color="#E7F0EA" />
          <SolidColorBrush x:Key="BadgeSnapshot" Color="#F4EEDF" />
          <SolidColorBrush x:Key="BadgeOther" Color="#EAEAF2" />
          <SolidColorBrush x:Key="ArgItemBg" Color="#F1F3F5" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- 全局配色 -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource WindowBg}" />
    </Style>

    <Style Selector="TextBlock.navTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.pageSub">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- 左侧导航按钮 -->
    <Style Selector="Button.navBtn">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="Margin" Value="8,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NavText}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
    </Style>
    <Style Selector="Button.navBtn.selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.navBtn.selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- 卡片 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18" />
    </Style>

    <!-- 主按钮（底色跟随强调色） -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryDisabledBg}" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource SecondaryBg}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryFg}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorder}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SecondaryHoverBg}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBg}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
    </Style>

    <!-- 输入框 -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 版本行 -->
    <Style Selector="Border.rowItem">
      <Setter Property="Background" Value="{DynamicResource RowItemBg}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.rowItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource RowItemHoverBg}" />
    </Style>

    <!-- 标签 -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource BadgeDefault}" />
    </Style>
    <Style Selector="Border.badgeRelease">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource BadgeRelease}" />
    </Style>
    <Style Selector="Border.badgeSnapshot">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource BadgeSnapshot}" />
    </Style>
    <Style Selector="Border.badgeOther">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource BadgeOther}" />
    </Style>
  </Application.Styles>
</Application>

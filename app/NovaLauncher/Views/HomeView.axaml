<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="760"
             x:Class="NovaLauncher.Views.HomeView">
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- ===== 顶栏 ===== -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="NovaLauncher" Classes="pageTitle" VerticalAlignment="Center" />
        <TextBlock Text="我的世界启动器" FontSize="11" Foreground="#5C6470" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Classes="badge" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="{Binding RunningText}" FontSize="11" Foreground="#9AA0A6" />
        </Border>
        <Button Classes="secondary" Command="{Binding ToggleCustomizeCommand}">
          <TextBlock Text="✎ 自定义主页" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ===== 编辑模式提示 ===== -->
    <Border Grid.Row="1" Classes="card" IsVisible="{Binding CustomizeOpen}" Margin="0,0,0,12" Padding="14,10">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Text="编辑模式：从右侧拖拽或点「＋添加」把插件放入网格；每个插件可调 1×1 / 1×2 / 2×1 / 2×2，悬停组件可拖拽移动，点 ✕ 删除。自动保存。"
                   FontSize="12" Foreground="#7FE08C" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- ===== 主内容：左侧网格 + 右侧侧边栏 ===== -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <ScrollViewer Grid.Column="0">
        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="12" Padding="10"
                HorizontalAlignment="Left">
          <Canvas x:Name="WidgetCanvas"
                  Width="{Binding GridCanvasWidth}"
                  Height="{Binding GridCanvasHeight}" />
        </Border>
      </ScrollViewer>

      <!-- 侧边栏：可添加的插件 / 小组件 -->
      <Border Grid.Column="1" Width="250" Classes="card" Padding="14"
              IsVisible="{Binding CustomizeOpen}">
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="插件 / 小组件" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="从侧边拿出插件放到网格（拖拽或点 ＋）" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,4,0,4" />
            <ItemsControl x:Name="SidebarItems" ItemsSource="{Binding AvailableWidgets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>

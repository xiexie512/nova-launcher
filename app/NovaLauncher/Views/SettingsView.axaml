<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaLauncher.Views.SettingsView">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left" Width="860">

      <StackPanel Spacing="4">
        <TextBlock Classes="pageTitle" Text="设置" />
        <TextBlock Classes="pageSub" Text="{Binding Status}" />
      </StackPanel>

      <!-- 个性化 · 外观 -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="🎨 外观主题" FontWeight="SemiBold" FontSize="15" />
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="界面主题" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" Width="220" SelectedIndex="{Binding Theme}">
              <ComboBoxItem Content="跟随系统" />
              <ComboBoxItem Content="浅色" />
              <ComboBoxItem Content="深色" />
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="强调色（#RRGGBB）" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <TextBox Width="160" Watermark="#3FA54B" Text="{Binding AccentColor}" />
              <TextBlock Text="用于主按钮与导航选中态，修改后即时生效" Classes="muted" VerticalAlignment="Center" FontSize="11" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 个性化 · 账号与默认服务器 -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="👤 账号与默认服务器" FontWeight="SemiBold" FontSize="15" />
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="离线默认用户名" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Width="300" Watermark="留空则自动 Steve+随机" Text="{Binding OfflineUsername}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="默认服务器地址" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="300" Watermark="ip:port，如 play.example.com:25565" Text="{Binding DefaultServer}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="自动进服" VerticalAlignment="Center" />
            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding AutoJoinServer}"
                      Content="启动游戏后自动加入默认服务器" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="muted" FontSize="11" TextWrapping="Wrap"
                       Text="「自动进服」需要同时填写上面的服务器地址；离线与正版账户均适用。" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 个性化 · 游戏与版本管理 -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="🗂️ 游戏与版本管理" FontWeight="SemiBold" FontSize="15" />
          <Grid ColumnDefinitions="200,*" ColumnSpacing="14" RowDefinitions="Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="默认启动版本" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <ComboBox Width="260" PlaceholderText="未设置（每次在主页选择实例）"
                        ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding DefaultVersion}" />
              <TextBlock Text="作为默认实例，便于一键启动" Classes="muted" VerticalAlignment="Center" FontSize="11" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 启动 -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="⚙️ 启动参数" FontWeight="SemiBold" FontSize="15" />
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="12">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="内存分配" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <Slider Minimum="512" Maximum="16384" TickFrequency="256" IsSnapToTickEnabled="True" Width="360"
                      Value="{Binding MemoryMb}" />
              <TextBlock Text="{Binding MemoryMb, StringFormat='{}{0} MB'}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="窗口分辨率（0=默认）" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBox Width="90" Text="{Binding Width}" />
              <TextBlock Text="×" VerticalAlignment="Center" />
              <TextBox Width="90" Text="{Binding Height}" />
              <TextBlock Text="像素" Classes="muted" VerticalAlignment="Center" FontSize="11" />
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="下载并发数" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
              <Slider Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Width="360" Value="{Binding Workers}" />
              <TextBlock Text="{Binding Workers}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Java -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="☕ Java 运行时" FontWeight="SemiBold" FontSize="15" />
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Java 路径（空=自动）" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBox Width="420" Watermark="留空则自动检测" Text="{Binding JavaPath}" />
              <Button Classes="secondary" Command="{Binding DetectJavaCommand}">
                <TextBlock Text="自动检测" />
              </Button>
              <Button Classes="secondary" Command="{Binding DownloadJavaCommand}">
                <TextBlock Text="下载 Java 21" />
              </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding JavaStatus}" Classes="muted" FontSize="11" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 下载源 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="🌐 下载源（多源聚合，加速下载）" FontWeight="SemiBold" FontSize="15" />
          <StackPanel Orientation="Horizontal" Spacing="20">
            <CheckBox IsChecked="{Binding UseMojang}" Content="Mojang 官方源" />
            <CheckBox IsChecked="{Binding UseBmclapi}" Content="BMCLAPI 镜像源" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMuted}"
                     Text="勾选多个源后，下载引擎会按顺序尝试、校验失败自动切换；配合并发下载充分利用带宽。" />
        </StackPanel>
      </Border>

      <!-- 额外 JVM 参数 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="🧪 额外 JVM 参数" FontWeight="SemiBold" FontSize="15" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="ArgBox" Grid.Column="0" Watermark="如 -XX:+UseZGC" />
            <Button Grid.Column="1" Classes="secondary" Click="AddArg_Click">
              <TextBlock Text="添加" />
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding ExtraArgs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource ArgItemBg}" CornerRadius="6" Padding="10,5" Margin="0,4,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding}" FontFamily="Menlo, Consolas, monospace" FontSize="12" />
                    <Button Grid.Column="1" Classes="danger" Padding="8,2"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveArgCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="✕" FontSize="10" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 账户/API -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="🔑 平台接入（API Key）" FontWeight="SemiBold" FontSize="15" />
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="微软 Client ID" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Width="420" Watermark="Azure 应用注册的 Application (client) ID，用于正版登录"
                     Text="{Binding MicrosoftClientId}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="CurseForge API Key" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="420" Watermark="用于 CurseForge 整合包模组下载（可选）"
                     Text="{Binding CurseForgeKey}" />
          </Grid>
          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMuted}"
                     Text="微软 Client ID 获取：登录 portal.azure.com → 应用注册 → 新建注册（支持的账户类型选「任何组织目录或任何 Microsoft 账户」）→ 复制「应用程序(客户端) ID」填到这里。" />
        </StackPanel>
      </Border>

      <!-- AI -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="🤖 AI 助手 Nova" FontWeight="SemiBold" FontSize="15" />
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="接口地址" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Width="420" Watermark="https://api.deepseek.com/v1 或 https://api.openai.com/v1 或本地 Ollama"
                     Text="{Binding AiEndpoint}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="420" Watermark="sk-…（Ollama 本地可留空）" Text="{Binding AiKey}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="模型名" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Width="420" Watermark="deepseek-chat / gpt-4o-mini / qwen2.5" Text="{Binding AiModel}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 关于 -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="ℹ️ 关于" FontWeight="SemiBold" FontSize="15" />
          <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}"
                     Text="NovaLauncher 我的世界启动器 · 自研 C 高性能内核 + Avalonia 跨平台界面" />
          <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" Text="数据目录：" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Command="{Binding OpenGameRootCommand}">
              <TextBlock Text="打开游戏目录" />
            </Button>
            <Button Classes="secondary" Command="{Binding OpenHomeDirCommand}">
              <TextBlock Text="打开数据目录" />
            </Button>
            <Button Classes="secondary" Command="{Binding SaveCommand}">
              <TextBlock Text="保存设置" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaLauncher.Views.VersionsView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,0,0">
    <!-- 工具栏 -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
      <TextBlock Classes="pageTitle" Text="游戏版本" VerticalAlignment="Center" />
      <Border Width="1" Height="24" Background="#222834" />
      <Button Classes="primary" Click="Download_Click">
        <TextBlock Text="⬇ 下载版本" />
      </Button>
      <Button Classes="secondary" Command="{Binding RefreshDownloadedCommand}">
        <TextBlock Text="⟳ 刷新" />
      </Button>
      <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
    </StackPanel>

    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding Busy}" Height="4" Margin="0,0,0,10" />

    <!-- 已下载版本列表 -->
    <ListBox Grid.Row="2" ItemsSource="{Binding Downloaded}" Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Classes="rowItem" Margin="0,0,0,8" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold" />
                <Border Classes="badgeRelease">
                  <TextBlock Text="{Binding Tag}" FontSize="10" Foreground="#7FE08C" />
                </Border>
                <TextBlock Text="{Binding McVersion, StringFormat='MC {0}'}" FontSize="11" Foreground="#5C6470" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding $parent[ListBox].DataContext.LaunchCommand}" CommandParameter="{Binding Id}">
                  <TextBlock Text="启动" />
                </Button>
                <Button Classes="secondary" Command="{Binding $parent[ListBox].DataContext.OpenDirCommand}" CommandParameter="{Binding Id}">
                  <TextBlock Text="打开目录" />
                </Button>
                <Button Classes="danger" Command="{Binding $parent[ListBox].DataContext.DeleteCommand}" CommandParameter="{Binding Id}">
                  <TextBlock Text="删除" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

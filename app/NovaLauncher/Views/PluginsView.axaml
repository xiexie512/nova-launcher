<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaLauncher.Views.PluginsView">
  <Grid RowDefinitions="Auto,*" Margin="0,0,0,0">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
      <TextBlock Classes="pageTitle" Text="插件" VerticalAlignment="Center" />
      <Border Width="1" Height="24" Background="#222834" />
      <Button Classes="secondary" Command="{Binding ReloadCommand}">
        <TextBlock Text="⟳ 重新加载" />
      </Button>
      <Button Classes="secondary" Command="{Binding OpenDirCommand}">
        <TextBlock Text="打开插件目录" />
      </Button>
      <TextBlock Text="把插件 dll / py / dylib 放入 plugins 目录即可加载（支持 C# / Python / C 三种语言）" Classes="muted" VerticalAlignment="Center" FontSize="12" />
    </StackPanel>

    <ListBox Grid.Row="1" ItemsSource="{Binding Plugins}" Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Classes="rowItem" Margin="0,0,0,8" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="v{Binding Version}" FontSize="11" Foreground="#9AA0A6" />
                  <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#5C6470" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9AA0A6" />
                <TextBlock Text="{Binding File}" FontSize="10" Foreground="#5C6470" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border CornerRadius="4" Background="#2B3240" Padding="6,2">
                  <TextBlock Text="{Binding Lang}" FontSize="11" Foreground="#9AA0A6" />
                </Border>
                <TextBlock Text="✓ 已加载" FontSize="12" Foreground="#7FE08C" IsVisible="{Binding Loaded}" />
                <TextBlock Text="✕ 加载失败" FontSize="12" Foreground="#E07070" IsVisible="{Binding !Loaded}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

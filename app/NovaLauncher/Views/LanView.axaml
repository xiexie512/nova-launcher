<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NovaLauncher.Views"
             x:Class="NovaLauncher.Views.LanView">
  <ScrollViewer>
    <StackPanel Spacing="16">

      <!-- 顶栏 -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="pageTitle" Text="虚拟局域网" VerticalAlignment="Center" />
          <Border Classes="badge" Padding="10,4">
            <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#7FE08C" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="NovaNet 自研 · 房间码 + 密码 · UDP 打洞直连" Classes="muted" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Command="{Binding ReconnectCommand}" IsEnabled="{Binding NotBusy}">
          <TextBlock Text="重连" />
        </Button>
      </Grid>

      <!-- Hub 连接配置 -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="🌐 Hub 服务器" FontWeight="SemiBold" FontSize="15" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9AA0A6"
                     Text="NovaNet 是启动器自研的虚拟局域网：自建协调服务器（Hub）+ WebSocket 信令/中继 + UDP 打洞 P2P 直连 + AES-GCM 端到端加密 + 本地端口映射，不需要安装任何第三方软件、不需要管理员权限。部署 Hub 的方法见仓库 nova-net-server/README.md；没有自建服务器时，可先填自己的 VPS 地址，或本机运行 Hub 填 127.0.0.1:8535 自测。" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBox Watermark="Hub 地址（如 hub.example.com:8535）" Text="{Binding HubAddress}" />
            <TextBox Grid.Column="1" Width="110" Watermark="本地游戏端口" Text="{Binding LocalGamePortText}" />
            <Button Grid.Column="2" Classes="primary" Command="{Binding ConnectCommand}" IsEnabled="{Binding NotBusy}">
              <TextBlock Text="保存并连接" />
            </Button>
            <Button Grid.Column="3" Classes="secondary" Command="{Binding ReconnectCommand}" IsEnabled="{Binding NotBusy}">
              <TextBlock Text="重连" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Text="连接状态" FontSize="11" Foreground="#9AA0A6" />
              <TextBlock Text="{Binding ConnectionStatus}" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="1" Width="1" Background="#2A2F3A" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="本机标识" FontSize="11" Foreground="#9AA0A6" />
              <TextBlock Text="{Binding ClientId}" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="3" Width="1" Background="#2A2F3A" />
            <StackPanel Grid.Column="4">
              <TextBlock Text="我的虚拟 IP" FontSize="11" Foreground="#9AA0A6" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding MyVirtualIp}" FontSize="14" FontWeight="SemiBold" Foreground="#7FE08C" />
                <Button Classes="secondary" Command="{Binding CopyMyIpCommand}" IsEnabled="{Binding InRoom}">
                  <TextBlock Text="复制" FontSize="11" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding LastMessage}" FontSize="11" Foreground="#E8B36A" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 未进房间：创建 / 加入 -->
      <Border Classes="card" IsVisible="{Binding NotInRoom}">
        <StackPanel Spacing="12">
          <TextBlock Text="🚪 创建房间 / 加入房间" FontWeight="SemiBold" FontSize="15" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9AA0A6"
                     Text="房主「创建房间」拿到 6 位房间码（可设密码），好友在「加入房间」输入房间码与密码即可。所有成员拿到 10.55.0.x 虚拟 IP，隧道自动打通。" />

          <Border Background="#1A1E26" CornerRadius="8" Padding="14,12">
            <StackPanel Spacing="10">
              <TextBlock Text="创建房间（我是房主）" FontWeight="SemiBold" FontSize="13" />
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <TextBox Watermark="房间名称（默认 玩家名 的房间）" Text="{Binding CreateName}" />
                <TextBox Grid.Column="1" Watermark="房间密码（可选）" Text="{Binding CreatePassword}" PasswordChar="●" />
                <Button Grid.Column="2" Classes="primary" Command="{Binding CreateRoomCommand}" IsEnabled="{Binding NotBusy}">
                  <TextBlock Text="创建" />
                </Button>
              </Grid>
              <TextBlock FontSize="11" Foreground="#9AA0A6" TextWrapping="Wrap"
                         Text="创建后：在游戏内打开存档 → ESC →「对局域网开放」（记住端口）→ 把房间码发给好友。好友的成员列表出现后，复制他的联机地址，在游戏「多人游戏→添加服务器」粘贴即可。" />
            </StackPanel>
          </Border>

          <Border Background="#1A1E26" CornerRadius="8" Padding="14,12">
            <StackPanel Spacing="10">
              <TextBlock Text="加入房间（我是成员）" FontWeight="SemiBold" FontSize="13" />
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <TextBox Watermark="6 位房间码" Text="{Binding JoinCode}" />
                <TextBox Grid.Column="1" Watermark="房间密码（有密码时必填）" Text="{Binding JoinPassword}" PasswordChar="●" />
                <Button Grid.Column="2" Classes="primary" Command="{Binding JoinRoomCommand}" IsEnabled="{Binding NotBusy}">
                  <TextBlock Text="加入" />
                </Button>
              </Grid>
              <TextBlock FontSize="11" Foreground="#9AA0A6" TextWrapping="Wrap"
                         Text="加入后等房主把虚拟 IP（10.55.0.x）或他的联机地址发给你；在游戏「多人游戏→添加服务器」填入 房主的虚拟IP:游戏端口，或直接填他的 127.0.0.1:200xx 联机地址。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 已进房间：房间信息 + 成员列表 -->
      <Border Classes="card" IsVisible="{Binding InRoom}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🛜 当前房间" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
              <Border Classes="badge" Padding="8,3">
                <TextBlock Text="{Binding RoomCode}" FontSize="11" Foreground="#7FE08C" FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="{Binding RoomName}" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="danger" Command="{Binding LeaveRoomCommand}" IsEnabled="{Binding NotBusy}">
              <TextBlock Text="离开房间" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="10">
            <StackPanel>
              <TextBlock Text="房间码" FontSize="11" Foreground="#9AA0A6" />
              <TextBlock Text="{Binding RoomCode}" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <Border Grid.Column="1" Width="1" Background="#2A2F3A" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="我的虚拟 IP" FontSize="11" Foreground="#9AA0A6" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding MyVirtualIp}" FontSize="14" FontWeight="SemiBold" Foreground="#7FE08C" />
                <Button Classes="secondary" Command="{Binding CopyMyIpCommand}">
                  <TextBlock Text="复制" FontSize="11" />
                </Button>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="3" Width="1" Background="#2A2F3A" />
            <StackPanel Grid.Column="4">
              <TextBlock Text="成员" FontSize="11" Foreground="#9AA0A6" />
              <TextBlock Text="{Binding Members.Count, StringFormat='{}{0} 人'}" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding Members}" IsVisible="{Binding HasMembers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#1A1E26" CornerRadius="8" Padding="14,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <Border Classes="badge" Padding="6,2">
                          <TextBlock Text="{Binding PathText}" FontSize="10" Foreground="#7FE08C" />
                        </Border>
                        <Border Classes="badge" Padding="6,2" IsVisible="{Binding IsOwner}">
                          <TextBlock Text="房主" FontSize="10" Foreground="#E8B36A" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding VirtualIp, StringFormat='虚拟 IP: {0}'}" FontSize="12" Foreground="#7FE08C" />
                      <TextBlock Text="{Binding ConnectAddress, StringFormat='联机地址: {0}'}" FontSize="11" Foreground="#9AA0A6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="secondary" Content="复制联机地址" FontSize="11"
                              Command="{Binding $parent[UserControl].DataContext.CopyMemberAddressCommand}" CommandParameter="{Binding}" />
                      <Button Classes="danger" Content="踢出" FontSize="11" IsVisible="{Binding $parent[UserControl].DataContext.CanKick}"
                              Command="{Binding $parent[UserControl].DataContext.KickCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding Members.Count, Converter={x:Static local:ObjectConverters.CountToEmpty}}">
            <TextBlock Text="还没有其他成员。把房间码（和密码）发给好友，他们加入后这里会实时出现。" FontSize="11" Foreground="#9AA0A6" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="{Binding LastMessage}" FontSize="11" Foreground="#E8B36A" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 联机教程 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="🎮 虚拟局域网联机教程（NovaNet）" FontWeight="SemiBold" FontSize="15" />
          <TextBlock FontSize="12" Foreground="#9AA0A6" TextWrapping="Wrap"
                     Text="1. 每台电脑配置同一个 Hub 地址并连接（自建服务器；也可本机自测 127.0.0.1:8535）；&#x0a;2. 房主点「创建房间」，把房间码（和密码）发给好友；好友点「加入房间」输入即可；&#x0a;3. 房主在游戏内打开存档 → ESC →「对局域网开放」（默认端口 25565）；&#x0a;4. 其他玩家在 NovaLauncher「服务器」页添加服务器，地址填 房主的虚拟 IP + 端口（如 10.55.0.2:25565），或直接复制房主的联机地址 127.0.0.1:200xx；&#x0a;5. 双方自动 UDP 打洞直连（打洞失败自动走服务器中继），加密传输，连接成功即完成跨网络联机。" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
